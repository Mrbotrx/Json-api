  "calculator": {
    "quantity_default": 1,
    "months_default": 1,
    "allow_quantity": true,
    "allow_month_selection": true,
    "formula": {
      "base_amount": "monthly_amount * quantity * months",
      "card_management_fee": "base_amount * 0.10",
      "public_welfare_fee": "base_amount * 0.10",
      "total_additional": "card_management_fee + public_welfare_fee",
      "total_payable": "base_amount + total_additional"
    }
  },

